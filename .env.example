# Copy to .env locally / set the same keys in Render Environment

PORT=8000
NODE_ENV=production
DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER/DB

JWT_SECRET_KEY=change-me

# Comma-separated Vercel frontend URL(s) — required for cookies + Socket.IO CORS
CLIENT_URL=https://YOUR-APP.vercel.app,http://localhost:2000

Nodemailer_GMAIL=
Nodemailer_GMAIL_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

UPLOAD_FOLDER=uploads
max_file_size=10485760

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
